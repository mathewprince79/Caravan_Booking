{
  "name": "caravan-booking",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Shared item booking PWA (caravans, trailers) on Cloudflare Workers, D1 and R2",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "build": "vite build",
    "postinstall": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.worker.json --noEmit",
    "preview": "npm run build && wrangler dev --port 8787",
    "deploy": "npm run typecheck && npm run build && wrangler deploy",
    "cf:deploy": "npm run build && wrangler d1 migrations apply caravan_booking --remote && wrangler deploy",
    "db:local": "wrangler d1 migrations apply caravan_booking --local",
    "db:remote": "wrangler d1 migrations apply caravan_booking --remote",
    "icons": "node scripts/make-icons.mjs"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261104.1",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "wrangler": "^4.0.0"
  }
}

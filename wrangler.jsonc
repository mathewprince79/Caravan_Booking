{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "caravan-booking",
  "main": "worker/index.ts",
  "compatibility_date": "2025-10-01",
  "observability": { "enabled": true },

  // Static SPA from `npm run build`; only /api/* is routed to the Worker first.
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },

  // Create with: wrangler d1 create caravan_booking
  // then paste the returned id below.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "caravan_booking",
      "database_id": "4e7edc7c-e69c-4023-8686-e94dd60a2c41",
      "migrations_dir": "migrations"
    }
  ],

  // Media lives in Workers KV: card-free on the free plan (1 GB total, 25 MB per
  // file, 1k writes/day). Create with: wrangler kv namespace create MEDIA
  "kv_namespaces": [
    {
      "binding": "MEDIA",
      "id": "7e574bdaf2694deebd2c02d7914b50d7"
    }
  ],

  // Daily reminder sweep: condition reports + parking address prompts.
  "triggers": {
    "crons": ["0 7 * * *"]
  },

  "vars": {
    "APP_NAME": "Caravan Club",
    "DEFAULT_TIMEZONE": "UTC",
    // Set this to your deployed URL (e.g. https://caravan-booking.you.workers.dev)
    // so reminder emails can link straight back to the app.
    "APP_URL": "https://caravan-booking.mathewprince.workers.dev"
  }
}
